@model MossHarper.Pages.ContactModel
<div id="contact-form">
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="form-success" role="status"><span aria-hidden="true">✓</span><h2>Enquiry received</h2><p>@Model.SuccessMessage</p><div class="success-actions"><a asp-page="/Contact" asp-route-again="true" asp-fragment="contact">Send another enquiry</a><a asp-page="/Index">Return to home</a></div></div>
}
else
{
    <form method="post" asp-page-handler="Send" hx-post="/Contact?handler=Send" hx-target="#contact-form" hx-swap="outerHTML">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="field"><label for="name">Name <span>*</span></label><input id="name" name="Input.Name" value="@Model.Input.Name" autocomplete="name" placeholder="Your name" required maxlength="120" /><span asp-validation-for="Input.Name"></span></div>
        <div class="field"><label for="organisation">Organisation <small>(optional)</small></label><input id="organisation" name="Input.Organisation" value="@Model.Input.Organisation" autocomplete="organization" placeholder="Organisation / company" maxlength="150" /></div>
        <div class="field"><label for="role">I am a… <small>(optional)</small></label><select id="role" asp-for="Input.Role"><option value="">Please select</option><option value="Developer or investor">Developer or investor</option><option value="Freeholder or asset owner">Freeholder or asset owner</option><option value="Managing agent or property business">Managing agent or property business</option><option value="RMC or RTM director">RMC or RTM director</option><option value="Leaseholder or resident">Leaseholder or resident</option><option value="Other">Other</option></select><span asp-validation-for="Input.Role"></span></div>
        <div class="field"><label for="email">Email <span>*</span></label><input id="email" name="Input.Email" value="@Model.Input.Email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254" /><span asp-validation-for="Input.Email"></span></div>
        <div class="field"><label for="message">Your challenge <span>*</span></label><textarea id="message" name="Input.Message" rows="5" placeholder="A brief description of the issue…" required minlength="10" maxlength="5000">@Model.Input.Message</textarea><span asp-validation-for="Input.Message"></span></div>
        <div class="trap" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="Website" tabindex="-1" autocomplete="off" /></div>
        <button class="v17-button v17-button-gold" type="submit">Send enquiry <span aria-hidden="true">→</span></button>
        <p class="privacy-copy">Your details will be used to respond to your enquiry. Please avoid including confidential documents. Read our <a asp-page="/Privacy">privacy information</a>.</p>
    </form>
}
</div>
