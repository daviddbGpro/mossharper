@model MossHarper.Pages.ContactModel
<div id="contact-form">
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="form-success" role="status"><span aria-hidden="true">✓</span><h2>Enquiry received</h2><p>@Model.SuccessMessage</p><div class="success-actions"><a asp-page="/Contact" asp-route-again="true">Send another enquiry</a><a asp-page="/Index">Return to home</a></div></div>
}
else
{
    <form method="post" asp-page-handler="Send" hx-post="/Contact?handler=Send" hx-target="#contact-form" hx-swap="outerHTML">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="field-row"><div class="field"><label for="name">Your name <span>*</span></label><input id="name" name="Input.Name" value="@Model.Input.Name" autocomplete="name" required maxlength="120" /><span asp-validation-for="Input.Name"></span></div><div class="field"><label for="email">Email address <span>*</span></label><input id="email" name="Input.Email" value="@Model.Input.Email" type="email" autocomplete="email" required maxlength="254" /><span asp-validation-for="Input.Email"></span></div></div>
        <div class="field"><label for="organisation">Organisation <small>Optional</small></label><input id="organisation" name="Input.Organisation" value="@Model.Input.Organisation" autocomplete="organization" maxlength="150" /></div>
        <div class="field"><label for="message">How can we help? <span>*</span></label><textarea id="message" name="Input.Message" rows="7" required minlength="10" maxlength="5000">@Model.Input.Message</textarea><span asp-validation-for="Input.Message"></span></div>
        <div class="trap" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="Website" tabindex="-1" autocomplete="off" /></div>
        <p class="privacy-copy">We use the details you provide to respond to your enquiry. Read our <a asp-page="/Privacy">privacy information</a>.</p>
        <button class="button button-dark" type="submit">Send enquiry <span aria-hidden="true">↗</span></button>
    </form>
}
</div>
